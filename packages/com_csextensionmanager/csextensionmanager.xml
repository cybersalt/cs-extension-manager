<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_CSEXTENSIONMANAGER</name>
    <element>com_csextensionmanager</element>
    <author>Cybersalt</author>
    <creationDate>October 2026</creationDate>
    <copyright>Copyright (C) 2026 Cybersalt. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>support@cybersalt.com</authorEmail>
    <authorUrl>https://cybersalt.com</authorUrl>
    <version>0.1.0</version>
    <description>COM_CSEXTENSIONMANAGER_XML_DESCRIPTION</description>

    <namespace path="src">Cybersalt\Component\Csextensionmanager</namespace>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <media destination="com_csextensionmanager" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>images</folder>
        <folder>js</folder>
    </media>

    <administration>
        <menu img="class:puzzle-piece" link="option=com_csextensionmanager&amp;view=extensions">COM_CSEXTENSIONMANAGER_MENU</menu>
        <submenu>
            <menu link="option=com_csextensionmanager&amp;view=extensions">COM_CSEXTENSIONMANAGER_SUBMENU_EXTENSIONS</menu>
            <menu link="option=com_csextensionmanager&amp;view=health">COM_CSEXTENSIONMANAGER_SUBMENU_HEALTH</menu>
            <menu link="option=com_csextensionmanager&amp;view=logs">COM_CSEXTENSIONMANAGER_SUBMENU_LOGS</menu>
            <menu link="option=com_config&amp;view=component&amp;component=com_csextensionmanager">COM_CSEXTENSIONMANAGER_SUBMENU_OPTIONS</menu>
        </submenu>
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>catalog</folder>
            <folder>forms</folder>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
        <languages folder="admin/language">
            <language tag="en-GB">en-GB/com_csextensionmanager.ini</language>
            <language tag="en-GB">en-GB/com_csextensionmanager.sys.ini</language>
        </languages>
    </administration>

    <changelogurl>https://www.cybersalt.com/index.php?option=com_csreleasemanager&amp;task=api.changelogxml&amp;format=raw&amp;element=pkg_csextensionmanager</changelogurl>
</extension>
